/* Engineered by Omonire (github.com/omonire) */
/* Challenge 007 - JavaScript Fetch API (ProvChart) */

/*
FSCSS means Figured Shorthand CSS. It is a small preprocessor that lets
this file use variables and short property names.
build_style.py compiles this file into style.css, which the browser reads.
*/

/* Design tokens live here so colours can be changed in one place. */
/* The ! after a variable asks FSCSS to put the value directly into the CSS. */
$accent: #0b6bcb;
$accent-dark: #0955a1;
$page: #eef1f5;
$panel: #fff;
$ink: #1d2433;
$line: #d7dce5;
$input-line: #9aa4b2;
$disabled: #8aa7c4;
$error: #b00020;
$success: #0a7a32;

/* A reusable block keeps the card and chart box looking related.
   @define works like a recipe: give it a selector, and it writes those styles.
   @use(sel) means "use the selector that was passed into this recipe". */
@define surface(sel){`
  @use(sel) {
    /* bg means background, and rounded means border-radius. */
    bg: $panel!;
    border: 1px solid $line!;
    rounded: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
  }
`}

/* Keep the page narrow so the chart is easy to read. */
body {
  margin: 0;
  padding: 32px 16px;
  bg: $page!;
  color: $ink!;
  font-family: system-ui, sans-serif;
}

.page {
  width: 90%;
  max-width: 900px;
  margin: 0 auto;
}

/* Calling @surface with a selector applies the shared card-like style. */
/* Normal CSS can be mixed with FSCSS, so this block adds card-only spacing.
   px means left and right padding, py means top and bottom padding,
   and stack makes a vertical flex layout with a gap. */
@surface(.card)

.card {
  px: 20px;
  py: 20px;
  stack: 12px;
}

label {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}

input {
  width: 100%;
  box-sizing: border-box;
  padding: 10px;
  border: 1px solid $input-line!;
  rounded: 8px;
  font-size: 15px;
}

button {
  margin-top: 12px;
  py: 10px;
  px: 16px;
  border: 0;
  rounded: 8px;
  bg: $accent!;
  color: #fff;
  font-size: 15px;
  cursor: pointer;
}

button:hover {
  bg: $accent-dark!;
}

button:disabled {
  bg: $disabled!;
  cursor: not-allowed;
}

/* Message colours make the result clear without needing extra words. */
#message {
  min-height: 20px;
  font-weight: 700;
}

#message.error {
  color: $error!;
}

#message.success {
  color: $success!;
}

#message.info {
  color: $accent!;
}

/* Reuse the same surface recipe for the chart output box. */
@surface(.chart-output)

.chart-output {
  min-height: 320px;
  margin-top: 20px;
  px: 16px;
  py: 16px;
}
